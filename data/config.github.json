      "enterprise-case": 12,
      "method-pitfall": 8,
      "beginner-tech": 10,
      "china-career": 9
    },
    "generated_hands_on": true,
    "quality_fill": true,
    "deep_items": 5,
    "brief_items": 15,
    "fulltext_reserve": 15,
    "max_items_per_source": 3,
    "max_today_use_per_source": 1,
